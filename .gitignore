dist/
*.zip.00*
*.7z.00*
*.tmp

# ---- caches ----
cache/*
!cache/.gitkeep
downloads/
*.npy
*.npz
*.log

# ---- user data / outputs ----
raw/*
!raw/.gitkeep
results/*
!results/*/
results/**/_tmp/*
data/train/audio/
data/val/audio/
exp/*/
!exp/.gitkeep
train_webui.log

